{
  "description": "Blocks deletion and unplanned moves inside a PARA root that apply.py has registered.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard_para_moves.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
